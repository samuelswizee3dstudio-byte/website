---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCatalogue, formatPrice } from '../lib/catalogue.mjs';

// The design handoff is explicit: a plain grid, no filters and no search.
// `category` metadata is still read by the catalogue and is available if a
// future brief wants grouping back.
const products = await getCatalogue();
const count = products.length;
// Derived, not asserted: "all under £10" silently became untrue the moment a
// £10 variant existed.
const ceiling = count ? formatPrice(Math.max(...products.map((p) => p.priceTo))) : null;
---
<Base title="Shop" description="Everything we print — fidgets, axolotls and personalised name items. Made to order in Warrington. UK delivery or free collection.">
  <div class="wrap shop">
    <header class="shop__head">
      <h1 class="t-page-title">Everything<br />we print</h1>
      <p class="lede">
        {count > 0
          ? `${count} ${count === 1 ? 'thing' : 'things'}, all ${ceiling} or less, all made after you order.`
          : 'New things are on the way.'}
      </p>
      {count > 0 && <p class="shop__count">{count} {count === 1 ? 'product' : 'products'}</p>}
    </header>

    {count === 0 ? (
      <p class="notice">
        The shop is empty right now. New things are on the way — follow
        <a href="https://www.instagram.com/swizee3dstudio" rel="noopener" target="_blank">@swizee3dstudio</a> for updates.
      </p>
    ) : (
      <ul class="grid-products">
        {products.map((p, i) => <ProductCard product={p} eager={i < 4} />)}
      </ul>
    )}
  </div>
</Base>

<style>
  .shop { padding-top: var(--sw-6); }
  .shop__head { position: relative; margin-bottom: var(--sw-5); display: grid; gap: var(--sw-3); }
  .shop__count { font-weight: 600; font-size: 14px; color: var(--sw-ink-soft); }
  @media (min-width: 900px) {
    .shop { padding-top: var(--sw-8); }
    .shop__head { margin-bottom: var(--sw-6); }
    .shop__count { position: absolute; right: 0; bottom: 0; }
  }
</style>
