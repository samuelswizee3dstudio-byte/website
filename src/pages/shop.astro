---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCatalogue } from '../lib/catalogue.mjs';

// The design handoff is explicit: a plain grid, no filters and no search.
// `category` metadata is still read by the catalogue and is available if a
// future brief wants grouping back.
const products = await getCatalogue();
const count = products.length;
// No price ceiling or product count in the header: the family asked for them
// to go, since new products and prices are coming and neither should read as
// a promise.
---
<Base title="Shop" description="Everything we print — sensory fidgets and personalised name keyrings. Made to order in Warrington. UK delivery or free collection.">
  <div class="wrap shop">
    <header class="shop__head">
      <h1 class="t-page-title">Everything<br />we print</h1>
      <p class="lede">
        {count > 0 ? 'Fidgets, made specially for you.' : 'New things are on the way.'}
      </p>
    </header>

    {count === 0 ? (
      <p class="notice">
        The shop is empty right now. New things are on the way — follow
        <a href="https://www.instagram.com/swizee3dstudio" rel="noopener" target="_blank">@swizee3dstudio</a> for updates.
      </p>
    ) : (
      <ul class="grid-products">
        {products.map((p, i) => <ProductCard product={p} eager={i < 4} />)}
      </ul>
    )}
  </div>
</Base>

<style>
  .shop { padding-top: var(--sw-6); }
  .shop__head { position: relative; margin-bottom: var(--sw-5); display: grid; gap: var(--sw-3); }
  @media (min-width: 900px) {
    .shop { padding-top: var(--sw-8); }
    .shop__head { margin-bottom: var(--sw-6); }
  }
</style>
