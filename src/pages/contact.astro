---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('copy', 'contact');
const { Content } = await render(page!);

// Web3Forms relays the message to the family's inbox. This key is public by
// design — it ships in the page source, only names the destination inbox, and
// cannot read past submissions. Committed deliberately: keeping it in an env
// var would mean a fresh clone silently builds a broken contact form, and
// there is nothing here worth protecting. Override with PUBLIC_WEB3FORMS_KEY.
const WEB3FORMS_KEY_DEFAULT = 'd165e1c0-b22d-42f3-9bc0-bbf901520c55';
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || WEB3FORMS_KEY_DEFAULT;
---
<Base title={page!.data.title} description={page!.data.description}>
  <div class="wrap wrap--narrow stack">
    <h1>{page!.data.title}</h1>

    <!-- Revealed by the script below when Web3Forms sends the visitor back with
         ?sent=1. The page is static, so this cannot be decided at build time. -->
    <p class="notice notice--ok" id="thanks" role="status" hidden>
      <strong>Thank you — your message has been sent.</strong><br />
      We will get back to you as soon as we can.
    </p>

    <div class="prose"><Content /></div>

    {!web3formsKey && (
      <p class="notice notice--warn">
        <strong>The contact form is not connected yet.</strong>
        Set <code>PUBLIC_WEB3FORMS_KEY</code> in the hosting environment variables.
      </p>
    )}

    <!-- Posted to Web3Forms, which emails the family. The botcheck field is a
         honeypot: bots fill it, humans never see it, and Web3Forms silently
         discards those. No captcha in front of a ten-year-old's parent. -->
    <form
      method="POST"
      action="https://api.web3forms.com/submit"
      class="stack form"
      id="contact-form"
    >
      <input type="hidden" name="access_key" value={web3formsKey} />
      <input type="hidden" name="subject" value="New message from the Swizee website" />
      <input type="hidden" name="from_name" value="Swizee 3D Studio" />
      <input type="hidden" name="redirect" value="https://swizee.co.uk/contact?sent=1" />
      <p class="hp" aria-hidden="true">
        <label>Do not fill this in<input name="botcheck" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="field">
        <label for="name">Your name</label>
        <input class="input" id="name" name="name" type="text" autocomplete="name" required maxlength="80" />
      </div>

      <div class="field">
        <label for="email">Your email</label>
        <input class="input" id="email" name="email" type="email" autocomplete="email" required maxlength="120" />
        <p class="hint">So we can reply. We do not use it for anything else.</p>
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea class="textarea" id="message" name="message" required maxlength="2000"
          placeholder="If it is about an order, please include the name you used at checkout."></textarea>
      </div>

      <button class="btn btn--primary" type="submit">Send message</button>
      <p class="hint">By sending this you agree to our <a href="/privacy">privacy notice</a>.</p>
    </form>

    <p class="notice">
      <strong>Getting your order:</strong> we post anywhere in the UK for £3.50, free over £20.
      Or collect for free from Great Sankey, Warrington — we email you to arrange a time
      once your order is ready.
    </p>
  </div>
</Base>

<script>
  if (new URLSearchParams(window.location.search).get('sent') === '1') {
    const thanks = document.querySelector<HTMLElement>('#thanks');
    if (thanks) {
      thanks.hidden = false;
      thanks.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
    document.querySelector<HTMLFormElement>('#contact-form')?.reset();
    // Leave a clean URL behind so a refresh does not re-show the message.
    window.history.replaceState({}, '', '/contact');
  }
</script>

<style>
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form { background: var(--sw-surface); border: 1px solid var(--sw-border); border-radius: var(--sw-r-lg); padding: var(--sw-5); }
</style>
