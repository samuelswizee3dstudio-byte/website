---
import Base from '../../layouts/Base.astro';
import { COLOUR_NOTE_MAX } from '../../lib/validation.mjs';
import { getCatalogue, formatPrice } from '../../lib/catalogue.mjs';
import { PERSONALISATION_PATTERN } from '../../lib/validation.mjs';

export async function getStaticPaths() {
  const products = await getCatalogue();
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const hasVariants = product.variants.length > 1;
const first = product.variants[0];
---
<Base title={product.name} description={product.description || `${product.name} — 3D printed to order by Swizee 3D Studio.`}>
  <div class="wrap pdp">
    <p class="crumb"><a href="/shop">Shop</a> <span aria-hidden="true">/</span> {product.name}</p>

    <div class="pdp__grid">
      <!-- Gallery -->
      <div class="gallery">
        {product.images.length > 1 && (
          <ul class="thumbs">
            {product.images.map((src: string, i: number) => (
              <li>
                <button type="button" data-src={src} aria-pressed={i === 0} aria-label={`Photo ${i + 1} of ${product.name}`}>
                  <img src={src} alt="" width="80" height="80" loading="lazy" />
                </button>
              </li>
            ))}
          </ul>
        )}
        <div class="gallery__main">
          {product.images.length > 0
            ? <img id="main-shot" src={product.images[0]} alt={product.name} width="800" height="1000" fetchpriority="high" />
            : <span class="shot-placeholder">{product.name.toLowerCase()} photo</span>}
          {product.images.length > 1 && (
            <>
              <button type="button" class="gallery__arrow gallery__arrow--prev" data-step="-1" aria-label="Previous photo">‹</button>
              <button type="button" class="gallery__arrow gallery__arrow--next" data-step="1" aria-label="Next photo">›</button>
              <p class="gallery__pos" aria-live="polite"><span data-pos>1</span> / {product.images.length}</p>
            </>
          )}
        </div>
        {product.video && (
          <video class="gallery__video" controls muted loop playsinline preload="metadata" poster={product.videoPoster ?? undefined} aria-label={`${product.name} in someone's hands`}>
            <source src={product.video} type="video/mp4" />
          </video>
        )}
      </div>

      <!-- Buy column -->
      <div class="buy">
        {product.personalise && <p><span class="badge badge--lilac">Personalisable</span></p>}
        <h1 class="t-page-title pdp__title">{product.name}</h1>
        <p class="pdp__price" data-price>{formatPrice(first.unitAmount)}</p>
        {product.description && <p class="pdp__desc">{product.description}</p>}

        <form id="add-form" novalidate data-slug={product.slug}>
          {hasVariants ? (
            <fieldset class="variants">
              <legend>{product.variantsLabel}</legend>
              <div class="variants__row">
                {product.variants.map((v: any, i: number) => (
                  <label class="variant">
                    <input type="radio" name="priceId" value={v.id} data-amount={v.unitAmount} data-max={v.maxChars} data-label={v.label} checked={i === 0} class="visually-hidden" />
                    <span class="variant__label">{v.label}</span>
                    <span class="variant__price">{formatPrice(v.unitAmount)}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ) : (
            <input type="hidden" name="priceId" value={first.id} data-amount={first.unitAmount} data-max={first.maxChars} />
          )}

          {product.colourChoices.length > 0 && (
            <div class="colours">
              {product.colourChoices.map((c: any) => (
                <div class="field">
                  <label for={`col-${c.key}`}>{c.label}</label>
                  <select class="input select" id={`col-${c.key}`} name={c.key} required data-custom={c.custom ? 'yes' : undefined}>
                    <option value="">Choose…</option>
                    {c.values.map((v: string) => <option value={v}>{v}</option>)}
                  </select>
                </div>
              ))}
              {product.colourChoices.some((c: any) => c.custom) && (
                <div class="field" id="custom-colour-field" hidden>
                  <label for="colourCustom">{product.colourCustomLabel}</label>
                  <input class="input" id="colourCustom" name="colourCustom" type="text"
                    maxlength={COLOUR_NOTE_MAX} autocomplete="off"
                    placeholder={product.colourCustomPlaceholder} />
                  <p class="hint" id="custom-colour-error" role="status" aria-live="polite"></p>
                </div>
              )}
            </div>
          )}

          {product.personalise && (
            <div class="field" id="text-field">
              <label for="text">{product.personaliseLabel}</label>
              <input
                class="input" id="text" name="text" type="text"
                autocomplete="off" autocapitalize="characters" spellcheck="false"
                maxlength={first.maxChars} pattern={PERSONALISATION_PATTERN} required
                aria-describedby="text-hint text-error"
              />
              <p class="hint" id="text-hint"><span data-counter>0</span> of <span data-max-label>{first.maxChars}</span> characters</p>
              <p class="error-text" id="text-error" role="alert" aria-live="polite"></p>
            </div>
          )}

          <div class="buy__row">
            <div class="stepper" role="group" aria-label="Quantity">
              <button type="button" data-step="-1" aria-label="One fewer">−</button>
              <input id="qty" name="qty" type="number" min="1" max="10" step="1" value="1" inputmode="numeric" aria-label="Quantity" />
              <button type="button" data-step="1" aria-label="One more">+</button>
            </div>
            <button class="btn btn--primary buy__add" type="submit">Add to cart</button>
          </div>

          <p class="error-text" id="form-error" role="alert" aria-live="assertive"></p>
          <p class="notice notice--ok added" role="status" hidden>
            <strong>Added to your basket.</strong>
            <a href="/cart">Go to basket →</a>
          </p>
          <noscript><p class="notice notice--warn">Please turn JavaScript on to add things to your basket.</p></noscript>
        </form>

        <div class="notice made">
          <strong>Custom and personalised orders are made to order — allow 7 days</strong>
          If your colours are in stock we send it out right away. Otherwise we
          print it once you've ordered, then message you when it's ready.
          Free local delivery if you are in a WA5 postcode. Anywhere else in the
          UK we post it for £3.50, free when you spend over £40, which takes
          another 2 to 3 days.
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { addLine } from '../../lib/cart.mjs';
  import { validatePersonalisation, validateColourNote } from '../../lib/validation.mjs';
  import { isCustomColour } from '../../lib/catalogue.mjs';

  const form = document.querySelector<HTMLFormElement>('#add-form');
  if (form) {
    const priceEl = document.querySelector<HTMLElement>('[data-price]');
    const textField = form.querySelector<HTMLElement>('#text-field');
    const textInput = form.querySelector<HTMLInputElement>('#text');
    const textError = form.querySelector<HTMLElement>('#text-error');
    const counter = form.querySelector<HTMLElement>('[data-counter]');
    const formError = form.querySelector<HTMLElement>('#form-error');
    const added = form.querySelector<HTMLElement>('.added');
    const submit = form.querySelector<HTMLButtonElement>('.buy__add')!;
    const qty = form.querySelector<HTMLInputElement>('#qty')!;

    const money = (p: number) => (p % 100 === 0 ? `£${p / 100}` : `£${(p / 100).toFixed(2)}`);

    const maxLabel = form.querySelector<HTMLElement>('[data-max-label]');
    const currentMax = () => {
      const chosen = form.querySelector<HTMLInputElement>('input[name="priceId"]:checked')
        ?? form.querySelector<HTMLInputElement>('input[name="priceId"]');
      const n = Number(chosen?.dataset.max);
      return Number.isInteger(n) && n > 0 ? n : 10;
    };

    for (const radio of form.querySelectorAll<HTMLInputElement>('input[name="priceId"]')) {
      radio.addEventListener('change', () => {
        const amount = Number(radio.dataset.amount);
        if (priceEl && Number.isFinite(amount)) priceEl.textContent = money(amount);

        // The letter allowance changes with the variant. Trim anything that no
        // longer fits rather than letting them pay for fewer letters than typed.
        const max = currentMax();
        if (textInput) {
          textInput.maxLength = max;
          if (textInput.value.length > max) textInput.value = textInput.value.slice(0, max);
          if (maxLabel) maxLabel.textContent = String(max);
          if (counter) counter.textContent = String(textInput.value.length);
          const check = validatePersonalisation(textInput.value, max);
          setError(textInput.value && !check.ok ? check.message : '');
          syncSubmit();
        }
      });
    }

    // Quantity stepper. The − button greys out at 1, per the handoff.
    const syncStepper = () => {
      const n = Number(qty.value) || 1;
      form.querySelector<HTMLButtonElement>('[data-step="-1"]')!.disabled = n <= 1;
      form.querySelector<HTMLButtonElement>('[data-step="1"]')!.disabled = n >= 10;
    };
    for (const btn of form.querySelectorAll<HTMLButtonElement>('[data-step]')) {
      btn.addEventListener('click', () => {
        const next = (Number(qty.value) || 1) + Number(btn.dataset.step);
        qty.value = String(Math.min(10, Math.max(1, next)));
        syncStepper();
      });
    }
    qty.addEventListener('change', syncStepper);
    syncStepper();

    // Add to cart stays disabled while a personalisable product has no valid name.
    const setError = (msg: string) => {
      if (textError) textError.textContent = msg;
      textField?.classList.toggle('is-error', Boolean(msg));
      textInput?.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };
    // A colour must be chosen before the item can be added, the same way a name
    // must. Without this the customer picks nothing and we print our best guess.
    const colourSelects = [...form.querySelectorAll<HTMLSelectElement>('.colours select')];
    // The free-text box belongs to whichever select offers "Custom"; it is
    // shown only while that is the chosen option, so nobody fills in a box that
    // will be ignored.
    const customField = document.querySelector<HTMLElement>('#custom-colour-field');
    const customInput = document.querySelector<HTMLInputElement>('#colourCustom');
    const customError = document.querySelector<HTMLElement>('#custom-colour-error');
    const customWanted = () =>
      colourSelects.some((sel) => sel.dataset.custom === 'yes' && isCustomColour(sel.value));

    const syncCustom = () => {
      const on = customWanted();
      if (customField) customField.hidden = !on;
      if (customInput) customInput.required = on;
      if (!on && customError) customError.textContent = '';
    };

    const coloursChosen = () =>
      colourSelects.every((sel) => sel.value !== '') &&
      (!customWanted() || validateColourNote(customInput?.value).ok);

    const syncSubmit = () => {
      const textOk = !textInput || validatePersonalisation(textInput.value, currentMax()).ok;
      submit.disabled = !(textOk && coloursChosen());
    };
    for (const sel of colourSelects) {
      sel.addEventListener('change', () => {
        if (formError) formError.textContent = '';
        syncCustom();
        syncSubmit();
      });
    }
    customInput?.addEventListener('input', () => {
      if (customError) customError.textContent = '';
      syncSubmit();
    });
    customInput?.addEventListener('blur', () => {
      if (!customWanted()) return;
      const check = validateColourNote(customInput.value);
      if (customError) customError.textContent = check.ok ? '' : check.message;
    });
    syncCustom();

    textInput?.addEventListener('input', () => {
      const cleaned = textInput.value.replace(/[^A-Za-z0-9]/g, '').slice(0, currentMax());
      const stripped = cleaned !== textInput.value;
      textInput.value = cleaned;
      if (counter) counter.textContent = String(cleaned.length);
      // Live counter while typing; the full message only once they have tried
      // something we cannot print.
      setError(stripped ? `Letters and numbers only, up to ${currentMax()}` : '');
      syncSubmit();
    });
    textInput?.addEventListener('blur', () => {
      const check = validatePersonalisation(textInput.value, currentMax());
      setError(check.ok ? '' : check.message);
      syncSubmit();
    });
    syncSubmit();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (formError) formError.textContent = '';
      if (added) added.hidden = true;

      const data = new FormData(form);
      const priceId = String(data.get('priceId') ?? '');
      const text = textInput ? String(data.get('text') ?? '') : '';

      if (textInput) {
        const check = validatePersonalisation(text, currentMax());
        if (!check.ok) { setError(check.message); textInput.focus(); return; }
        setError('');
      }

      if (colourSelects.some((sel) => !sel.value)) {
        if (formError) formError.textContent = 'Please choose a colour first.';
        colourSelects.find((sel) => !sel.value)?.focus();
        return;
      }
      if (customWanted()) {
        const check = validateColourNote(customInput?.value);
        if (!check.ok) {
          if (customError) customError.textContent = check.message;
          customInput?.focus();
          return;
        }
      }

      const chosen = form.querySelector<HTMLInputElement>('input[name="priceId"]:checked')
        ?? form.querySelector<HTMLInputElement>('input[name="priceId"]');
      const result = addLine({
        priceId,
        slug: form.dataset.slug ?? '',
        variant: chosen?.dataset.label ?? '',
        text,
        colour: String(data.get('colour') ?? ''),
        colour2: String(data.get('colour2') ?? ''),
        colourCustom: customWanted() ? String(data.get('colourCustom') ?? '') : '',
        qty: Number(data.get('qty') ?? 1),
      });
      if (!result.ok) {
        if (formError) formError.textContent = result.message;
        return;
      }
      if (added) added.hidden = false;
    });
  }

  // Gallery: thumbnails, arrows, arrow keys and a swipe all move the same index.
  const mainShot = document.querySelector<HTMLImageElement>('#main-shot');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.thumbs button')];
  const posEl = document.querySelector<HTMLElement>('[data-pos]');
  let current = 0;
  const show = (i: number) => {
    if (!thumbs.length) return;
    current = (i + thumbs.length) % thumbs.length;
    const src = thumbs[current].dataset.src;
    if (mainShot && src) mainShot.src = src;
    thumbs.forEach((b, j) => b.setAttribute('aria-pressed', String(j === current)));
    if (posEl) posEl.textContent = String(current + 1);
  };
  thumbs.forEach((btn, i) => btn.addEventListener('click', () => show(i)));
  for (const arrow of document.querySelectorAll<HTMLButtonElement>('.gallery__arrow')) {
    arrow.addEventListener('click', () => show(current + Number(arrow.dataset.step)));
  }
  const gallery = document.querySelector<HTMLElement>('.gallery__main');
  if (gallery && thumbs.length > 1) {
    gallery.tabIndex = 0;
    gallery.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
    });
    let startX: number | null = null;
    gallery.addEventListener('pointerdown', (e) => { startX = e.clientX; });
    gallery.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX; startX = null;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .pdp { padding-top: var(--sw-4); }
  .crumb { font-weight: 600; font-size: 14px; color: var(--sw-ink-soft); margin-bottom: var(--sw-4); }
  .pdp__grid { display: grid; gap: var(--sw-5); align-items: start; }

  /* Mobile: full-bleed square photo, then a horizontal thumbnail row. */
  .gallery__main { aspect-ratio: 1; border-radius: var(--sw-r-lg); overflow: hidden; background: var(--sw-bg); }
    /* `contain`, not `cover`: Rebecca's colour-combination shots carry the combo
     name printed along the bottom, and a cover crop cut it off and zoomed into
     the middle — "the image for bubblegum seems to be too close up", 8 Sept
     2026. Showing the whole photograph costs a little empty ground on an
     odd-shaped one and never hides what the picture is for. */
  .gallery__main img { width: 100%; height: 100%; object-fit: contain; touch-action: pan-y; user-select: none; -webkit-user-drag: none; }
  .gallery__main { position: relative; }
  .gallery__main:focus-visible { outline: 3px solid var(--sw-ink); outline-offset: 2px; }
  .gallery__arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 40px; height: 40px; border-radius: 50%; border: 0; cursor: pointer;
    background: var(--sw-surface); color: var(--sw-ink); box-shadow: var(--sw-shadow-card);
    font-size: 26px; line-height: 1; font-weight: 800; padding: 0 0 3px;
  }
  .gallery__arrow--prev { left: var(--sw-3); }
  .gallery__arrow--next { right: var(--sw-3); }
  .gallery__arrow:hover { background: var(--sw-bg); }
  .gallery__pos {
    position: absolute; right: var(--sw-3); bottom: var(--sw-3); margin: 0;
    padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 700;
    background: var(--sw-surface); color: var(--sw-ink-soft);
  }
  .gallery__video { display: block; width: 100%; margin-top: var(--sw-3); border-radius: var(--sw-r-lg); background: var(--sw-bg); }
  .thumbs { display: flex; gap: var(--sw-2); list-style: none; margin: 0 0 var(--sw-3); padding: 0; overflow-x: auto; }
  .thumbs li { flex: none; }
  .thumbs button { padding: 0; border: 2px solid var(--sw-border); border-radius: 12px; background: none; cursor: pointer; overflow: hidden; line-height: 0; }
  .thumbs button[aria-pressed='true'] { border-color: var(--sw-ink); }
  .thumbs img { width: 56px; height: 56px; object-fit: contain; background: var(--sw-surface); }

  .buy { display: grid; gap: var(--sw-3); }
  .pdp__title { margin-top: var(--sw-1); }
  .pdp__price { font-weight: 800; font-size: 24px; color: var(--sw-accent); }
  .pdp__desc { color: var(--sw-ink-soft); }

  #add-form { display: grid; gap: var(--sw-4); margin-top: var(--sw-2); }

  /* --- Variant tiles -------------------------------------------------------- */
  .variants { border: 0; padding: 0; margin: 0; }
  .variants legend { font-weight: 800; font-size: 14px; padding: 0; margin-bottom: var(--sw-2); }
  .variants__row { display: flex; flex-wrap: wrap; gap: var(--sw-2); }
  .variant {
    display: grid; gap: 2px; cursor: pointer; text-align: center;
    padding: 14px 22px; border-radius: 12px;
    background: var(--sw-surface); border: 2px solid var(--sw-border);
  }
  .variant__label { font-weight: 800; font-size: 14px; }
  .variant__price { font-weight: 600; font-size: 13px; color: var(--sw-ink-soft); }
  .variant:has(input:checked) { background: var(--sw-ink); border-color: var(--sw-ink); color: var(--sw-surface); }
  .variant:has(input:checked) .variant__price { color: var(--sw-surface); opacity: .75; }
  .variant:has(input:focus-visible) { outline: 2px solid var(--sw-accent); outline-offset: 2px; }

  /* --- Quantity stepper ------------------------------------------------------ */
  .buy__row { display: flex; gap: var(--sw-3); align-items: stretch; }
  .stepper {
    display: flex; align-items: stretch; flex: none;
    background: var(--sw-surface); border: 2px solid var(--sw-border);
    border-radius: var(--sw-r-pill); overflow: hidden;
  }
  .stepper button {
    width: 44px; border: 0; background: none; cursor: pointer;
    font-size: 20px; font-weight: 800; line-height: 1; color: var(--sw-ink);
  }
  .stepper button:disabled { color: var(--sw-ink-soft); cursor: default; }
  .stepper input {
    width: 40px; border: 0; background: none; text-align: center;
    font-weight: 800; -moz-appearance: textfield; appearance: textfield;
  }
  .stepper input::-webkit-outer-spin-button, .stepper input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .buy__add { flex: 1; }

  .made { margin-top: var(--sw-2); }
  .made strong { margin-bottom: var(--sw-1); }
  .added a { font-weight: 800; }

  /* --- Desktop --------------------------------------------------------------- */
  @media (min-width: 900px) {
    .pdp { padding-top: var(--sw-5); }
    .pdp__grid { grid-template-columns: 1.1fr 1fr; gap: 56px; }
    /* Two columns only when there is a thumbnail strip to fill the first one —
       otherwise the main photo lands in the 80px column. */
    .gallery:has(.thumbs) { display: grid; grid-template-columns: 80px 1fr; gap: var(--sw-3); align-items: start; }
    .gallery__video { grid-column: 2; margin-top: 0; }
    .thumbs { flex-direction: column; margin: 0; overflow: visible; }
    .thumbs img { width: 76px; height: 76px; }
    .gallery__main { aspect-ratio: 4 / 5; }
    .buy { gap: var(--sw-4); }
    .pdp__price { font-size: 28px; }
    .stepper button { width: 48px; }
    .stepper input { height: 56px; }
  }
</style>
