---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/shop', label: 'Shop' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact', desktopOnly: true },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="nav">
  <div class="nav__inner">
    <a href="/" class="lockup" aria-label="Swizee 3D Studio, home">
      <img src="/logo.png" alt="" width="60" height="60" />
      <span class="lockup__word"><span class="lockup__short">Swizee</span><span class="lockup__long">Swizee 3D Studio</span></span>
    </a>

    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li class={l.desktopOnly ? 'desktop-only' : undefined}>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
        <li>
          <a class="cart" href="/cart" aria-label="Basket">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 7h16l-1.3 12.2a2 2 0 0 1-2 1.8H7.3a2 2 0 0 1-2-1.8Z" />
              <path d="M8.5 7V5.5a3.5 3.5 0 0 1 7 0V7" />
            </svg>
            <span class="cart__count" data-cart-count hidden>0</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Mobile: plain white bar with a hairline. */
  .nav { background: var(--sw-surface); border-bottom: 1px solid var(--sw-border); }
  .nav__inner {
    display: flex; align-items: center; gap: var(--sw-4);
    padding: var(--sw-3) var(--sw-gutter); min-height: 64px;
  }

  .lockup { display: flex; align-items: center; gap: 10px; color: var(--sw-ink); margin-right: auto; }
  .lockup img { width: 44px; height: 44px; border-radius: 50%; }
  .lockup__word { font-family: var(--sw-font-display); font-size: 17px; text-transform: uppercase; line-height: 1; letter-spacing: .01em; }
  .lockup__long { display: none; }

  nav ul { display: flex; align-items: center; gap: var(--sw-4); list-style: none; margin: 0; padding: 0; }
  nav a { font-weight: 800; font-size: 14px; color: var(--sw-ink); }
  nav a:hover { color: var(--sw-accent); }
  nav a[aria-current='page'] { color: var(--sw-accent); }
  .desktop-only { display: none; }

  .cart { position: relative; display: grid; place-items: center; width: 44px; height: 44px; color: var(--sw-ink); }
  .cart__count {
    position: absolute; top: 2px; right: 0;
    background: var(--sw-accent); color: var(--sw-accent-ink);
    border-radius: var(--sw-r-pill); min-width: 18px; padding: 0 5px;
    font-size: 11px; font-weight: 800; line-height: 18px; text-align: center;
  }

  /* Desktop: floating white pill, 20px below the top inside the gutter. */
  @media (min-width: 900px) {
    .nav { background: transparent; border-bottom: 0; padding: 20px var(--sw-gutter) 0; }
    .nav__inner {
      max-width: var(--sw-wrap); margin-inline: auto;
      background: var(--sw-surface); border-radius: var(--sw-r-pill);
      box-shadow: var(--sw-shadow-sm); padding: 10px 24px; min-height: 76px;
    }
    .lockup img { width: 60px; height: 60px; }
    .lockup__word { font-size: 22px; }
    .lockup__short { display: none; }
    .lockup__long { display: inline; }
    nav ul { gap: 36px; }
    nav a { font-size: 15px; }
    .desktop-only { display: list-item; }
  }
</style>
