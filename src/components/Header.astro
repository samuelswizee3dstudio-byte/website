---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/shop', label: 'Shop' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Swizee 3D Studio, home">
      <img src="/logo.svg" alt="" width="40" height="40" />
      <span class="logo__text">Swizee<span class="logo__sub">3D Studio</span></span>
    </a>

    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <a
        class="ig"
        href="https://www.instagram.com/swizee3dstudio"
        rel="me noopener"
        target="_blank"
        aria-label="Swizee 3D Studio on Instagram (opens in a new tab)"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
          <circle cx="12" cy="12" r="4.2" />
          <circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <a class="basket" href="/cart">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16l-1.3 12.2a2 2 0 0 1-2 1.8H7.3a2 2 0 0 1-2-1.8Z" />
          <path d="M8.5 7V5.5a3.5 3.5 0 0 1 7 0V7" />
        </svg>
        <span>Basket</span>
        <span class="count" data-cart-count hidden>0</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-line);
    position: sticky; top: 0; z-index: 20;
  }
  .bar {
    display: flex; align-items: center; gap: var(--s-4);
    min-height: 64px; flex-wrap: wrap;
  }
  .logo { display: flex; align-items: center; gap: var(--s-2); text-decoration: none; color: var(--c-ink); margin-right: auto; }
  .logo__text { font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; line-height: 1; display: grid; }
  .logo__sub { font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--c-ink-soft); font-weight: 700; }

  nav ul { display: flex; gap: var(--s-1); list-style: none; margin: 0; padding: 0; }
  nav li { max-width: none; }
  nav a {
    display: block; padding: var(--s-2) var(--s-3);
    font-weight: 600; text-decoration: none; color: var(--c-ink-soft);
    border-radius: var(--r-pill);
  }
  nav a:hover { color: var(--c-ink); background: var(--c-surface-alt); }
  nav a[aria-current='page'] { color: var(--c-brand-dark); background: var(--c-brand-tint); }

  .tools { display: flex; align-items: center; gap: var(--s-2); }
  .ig { color: var(--c-ink-soft); padding: var(--s-2); border-radius: var(--r-pill); display: flex; }
  .ig:hover { color: var(--c-brand); background: var(--c-brand-tint); }

  .basket {
    display: inline-flex; align-items: center; gap: var(--s-2);
    padding: var(--s-2) var(--s-4); min-height: 44px;
    background: var(--c-ink); color: #fff; border-radius: var(--r-pill);
    font-weight: 700; font-size: var(--fs-sm); text-decoration: none;
  }
  .basket:hover { background: var(--c-brand-dark); color: #fff; }
  .count {
    background: var(--c-brand); color: #fff;
    border-radius: var(--r-pill); min-width: 1.4rem; padding: 0 0.35rem;
    text-align: center; font-size: var(--fs-xs); line-height: 1.4rem;
  }
  @media (max-width: 30rem) {
    .bar { min-height: 0; padding-block: var(--s-3); }
    .basket span:not(.count) { display: none; }
    nav { order: 3; width: 100%; }
    nav ul { justify-content: space-between; }
  }
</style>
