---
<footer class="foot">
  <div class="foot__inner">
    <p class="foot__note">Made to order, allow 7&nbsp;days. Collection from Great Sankey, Warrington.</p>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/shop">Shop</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="https://www.instagram.com/swizee3dstudio" rel="me noopener" target="_blank">@swizee3dstudio</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .foot { background: var(--sw-surface); border-top: 1px solid var(--sw-border); margin-top: var(--sw-9); }
  .foot__inner {
    max-width: var(--sw-wrap); margin-inline: auto;
    padding: var(--sw-5) var(--sw-gutter);
    display: flex; flex-wrap: wrap; gap: var(--sw-4); justify-content: space-between; align-items: center;
  }
  .foot__note { font-weight: 800; font-size: 15px; }
  .foot ul { display: flex; flex-wrap: wrap; gap: var(--sw-4); list-style: none; margin: 0; padding: 0; }
  .foot a { font-weight: 600; font-size: 14px; color: var(--sw-ink-soft); }
  .foot a:hover { color: var(--sw-accent); }
  @media (min-width: 900px) { .foot__inner { padding: var(--sw-6) var(--sw-gutter); } }
</style>
