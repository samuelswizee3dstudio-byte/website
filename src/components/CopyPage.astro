---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

interface Props { slug: string }
const { slug } = Astro.props;
const page = await getEntry('copy', slug);
if (!page) throw new Error(`Missing src/content/copy/${slug}.md`);
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <div class="wrap wrap--narrow">
    <h1>{page.data.title}</h1>
    <div class="prose legal"><Content /></div>
  </div>
</Base>

<style>
  .legal { margin-top: var(--sw-5); font-size: var(--sw-text-small); }
  .legal :global(blockquote) {
    border-left: 4px solid var(--sw-accent);
    background: var(--sw-surface);
    padding: var(--sw-3) var(--sw-4);
    border-radius: var(--sw-r-sm);
  }
  .legal :global(blockquote p) { max-width: none; }
  .legal :global(code) {
    background: var(--sw-bg); padding: 0.1em 0.35em;
    border-radius: 4px; font-size: 0.9em;
  }
</style>
