---
import { formatCardPrice } from '../lib/catalogue.mjs';

const { product, eager = false } = Astro.props;
const img = product.images[0];
---
<li class="pcard">
  {product.personalise && <span class="badge badge--lilac">Personalisable</span>}
  <a href={`/products/${product.slug}`}>
    <div class="pcard__shot">
      {img
        ? <img src={img} alt={product.name} loading={eager ? 'eager' : 'lazy'} decoding="async" width="480" height="480" />
        : <span class="shot-placeholder">{product.name.toLowerCase()} photo</span>}
    </div>
    <h3 class="pcard__title">{product.name}</h3>
    <p class="pcard__price">{formatCardPrice(product)}</p>
  </a>
</li>
