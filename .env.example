# Copy to .env for local development. Never commit .env.
# On Netlify these live in: Site configuration > Environment variables.

# --- Required ---------------------------------------------------------------
# Stripe secret key. Test key (sk_test_...) during the build, live key
# (sk_live_...) at go-live. Used at build time to fetch the catalogue and at
# request time by the checkout function. NEVER put this in the repo.
STRIPE_SECRET_KEY=sk_test_replace_me

# --- Automatic rebuilds (optional but recommended) --------------------------
# Netlify build hook URL: Site configuration > Build & deploy > Build hooks.
NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/replace_me
# Signing secret from the Stripe webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Optional ---------------------------------------------------------------
# Stripe makes the phone field REQUIRED at checkout once enabled, so this is
# off unless you set it to exactly "true".
COLLECT_PHONE=false

# Set automatically by Netlify — listed here so you know they are used:
#   URL, DEPLOY_PRIME_URL  -> checkout success/cancel redirect origin
#   CONTEXT                -> "production" builds refuse to run without a Stripe key
