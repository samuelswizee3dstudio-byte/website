# Copy to .env for local development. Never commit .env.
# On Cloudflare these live in: Pages project -> Settings -> Variables and secrets.
#   https://dash.cloudflare.com/?to=/:account/pages/view/website/settings

# --- Required ---------------------------------------------------------------
# Stripe secret key. Test key (sk_test_...) while building, live key
# (sk_live_...) in production. Used at build time to fetch the catalogue and at
# request time by the checkout function. NEVER put this in the repo.
STRIPE_SECRET_KEY=sk_test_replace_me

# --- Automatic rebuilds -----------------------------------------------------
# Signing secret from the Stripe webhook endpoint (whsec_...). Verifies that
# rebuild requests really came from Stripe.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# The Pages deploy hook. Set as a SECRET on the rebuild worker, not here:
#   npx wrangler secret put DEPLOY_HOOK_URL --config workers/wrangler.toml
# DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/...

# --- Optional ---------------------------------------------------------------
# Absolute site URL, used for Stripe Checkout success/cancel redirects.
SITE_URL=https://swizee.co.uk

# Checkout asks for a phone number (required — Stripe has no "optional" setting).
# Set to exactly "false" to stop asking.
COLLECT_PHONE=true

# Overrides the committed Web3Forms key for the contact form. Public by design.
# PUBLIC_WEB3FORMS_KEY=

# Temporary escape hatch: lets a hosted build ship the sample catalogue when no
# Stripe key is set. Delete once STRIPE_SECRET_KEY is configured.
# ALLOW_SAMPLE_CATALOGUE=true

# --- Local tooling only (not needed by the site) ----------------------------
# CLOUDFLARE_API_TOKEN=   # for wrangler and the Pages API
